From: validol1979-ops <225744605+validol1979-ops@users.noreply.github.com>
Date: Fri, 23 Oct 2026 18:30:27 +0300
Subject: [PATCH 12/12] board: the host's stop word to every slice (a
 multi-slice generate run hung on a stop)

run_generate wrote the stop word (S_HALT) to slice 0's state block alone; each slice reads its
own. Slice 0 halted after the token, the others went on and waited for it at their next
exchange: the run hung, running, no instruction issued, slice 0's ICOUNT ~300 behind the
others' (VCU128 S = 4, otpu-serve: a request stopped for another's turn; hang_report). Now
_ask_halt writes every slice's. A write landing between two slices' reads of the word still
splits them (rare; TOKEN_TIMEOUT ends it).

diff --git a/opentpu/host/board.py b/opentpu/host/board.py
index d1c846d2..513f3722 100644
--- a/opentpu/host/board.py
+++ b/opentpu/host/board.py
@@ -2015,7 +2015,7 @@ class BoardBackend:
                                        f"the generate run did not halt in {TOKEN_TIMEOUT:.0f} s "
                                        f"after its last token, served all along")
                 if stop is not None and not asked and state is not None and stop():
-                    b.write(state + 4 * G.S_HALT, np.ones(1, np.float32))
+                    self._ask_halt(state)
                     asked = True
                 if served:
                     continue
@@ -2031,7 +2031,7 @@ class BoardBackend:
             self._running = None
             if b.in_run and state is not None and not asked:
                 try:                            # (the card halts after the token in flight)
-                    b.write(state + 4 * G.S_HALT, np.ones(1, np.float32))
+                    self._ask_halt(state)
                 except Exception:               # noqa: BLE001 (the error raised is the one)
                     pass
             b.abort(STOP_WAIT)
@@ -2054,6 +2054,19 @@ class BoardBackend:
             self.status.token(st["cycles"], khz, dram=self._layout(True))
         return st, got
 
+    def _ask_halt(self, state: int) -> None:
+        """The host's stop word (generate.py S_HALT) to every slice's state block: each slice
+        reads its own (the host writes the block to each, qwen3 generate_card). Written to slice 0
+        alone, slice 0 halted after the token and the others went on to the next one, waiting
+        for slice 0 at their first exchange: the run hung, running, no instruction issued, slice
+        0's ICOUNT behind the others' (VCU128 S = 4, 2026-10-23: a request stopped for another's
+        turn). The slices read the word at their own times, so a write between two slices' reads
+        still splits them (rare: microseconds of a token's tens of ms; TOKEN_TIMEOUT ends it)."""
+        from opentpu.llm import generate as G
+        one = np.ones(1, np.float32)
+        for s in range(self.cfg.S):
+            self.board.write(state + 4 * G.S_HALT, one, s)
+
     def _hang_report(self, state: int | None, k: int, n: int) -> None:
         """A generate run taken for hung: the card's registers (Board.hang_report) and its state
         block's words (generate.py S_*) to stderr, before it is stopped. Never raises."""
diff --git a/tests/test_host_runs.py b/tests/test_host_runs.py
index 7c409fae..2558522c 100644
--- a/tests/test_host_runs.py
+++ b/tests/test_host_runs.py
@@ -209,6 +209,37 @@ def test_an_interrupted_generate_run_halts_after_its_token(monkeypatch):
     be.close()
 
 
+def test_the_stop_word_goes_to_every_slice(monkeypatch):
+    """stop() true: the host's stop word goes to each slice's state block (each slice reads its
+    own). To slice 0 alone, slice 0 halted and the others waited for it at their next exchange:
+    the run hung (VCU128 S = 4, 2026-10-23)."""
+    import types
+    from opentpu.llm import generate as G
+    monkeypatch.setattr(B, "STOP_WAIT", 0.05)
+    t = FakeTransport(run_s=1e9, devname=None, gen=True)
+    be = BoardBackend(board_config(DRAM_BYTES=1 << 21), [np.zeros(1 << 16, np.uint8)],
+                      transport=t, status=False)
+    state, out = 1 << 16, (1 << 16) + 4096
+    be.board.write(out, np.full(64, G.OUT_MARK, np.uint32))
+    wrote, w = [], be.board.write
+
+    def rec(addr, data, s=0):
+        if addr == state + 4 * G.S_HALT:
+            wrote.append(s)
+        if s == 0:
+            w(addr, data, s)
+    monkeypatch.setattr(be.board, "write", rec)
+    be.cfg = types.SimpleNamespace(**{**vars(be.cfg), "S": 4})
+    asks = iter([False, True])
+    with pytest.raises(TimeoutError):           # (the fake card never halts)
+        monkeypatch.setattr(B, "TOKEN_TIMEOUT", 0.2)
+        monkeypatch.setattr(B, "HANG_PAUSE", 0.01)
+        be.run_generate(np.zeros(16, np.uint32), out, 16, stop=lambda: next(asks, True),
+                        state=state)
+    assert wrote == [0, 1, 2, 3]
+    be.close()
+
+
