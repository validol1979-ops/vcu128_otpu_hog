index 74a3c230..e48f7e2d 100644
--- a/opentpu/kernels/layouts.py
+++ b/opentpu/kernels/layouts.py
@@ -7,6 +7,12 @@ def head_parallel_attention_weights(wq, wk, wv, wo, n_q_heads, n_kv_heads, d, S)
     that slice owns (KV heads s, s+S, ... and their query groups), and the columns of wo follow
     the slice-major order in which `attention_layer` all-gathers the head outputs. When
     S > n_kv_heads, consecutive slices replicate a KV head and split its query group."""
+    qrows, kvrows = head_parallel_indices(n_q_heads, n_kv_heads, d, S)
+    return wq[qrows], wk[kvrows], wv[kvrows], wo[:, qrows]
+
+
+def head_parallel_indices(n_q_heads, n_kv_heads, d, S):
+    """Query and KV row order for slice-major head-parallel attention weights."""
     G = n_q_heads // n_kv_heads
     if n_kv_heads % S == 0:
         kv_order = [h for s in range(S) for h in range(s, n_kv_heads, S)]
@@ -20,4 +26,4 @@ def head_parallel_attention_weights(wq, wk, wv, wo, n_q_heads, n_kv_heads, d, S)
                          "slices, or be a multiple of the slice count")
     qrows = np.concatenate([np.arange(h * d, (h + 1) * d) for h in q_order])
     kvrows = np.concatenate([np.arange(h * d, (h + 1) * d) for h in kv_order])
-    return wq[qrows], wk[kvrows], wv[kvrows], wo[:, qrows]
+    return qrows, kvrows
