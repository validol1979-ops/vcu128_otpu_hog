+@pytest.mark.parametrize("S", [2, 4])
+def test_fit_uses_per_slice_budget(tiny_slices, S, monkeypatch):
+    """Try host PLE against actual DRAM before unnecessarily changing int8 weight formats."""
+    for key in ("OTPU_FORMATS", "OTPU_PLE_FORMAT", "OTPU_PLE_HOST"):
+        monkeypatch.delenv(key, raising=False)
+    spec = tiny_slices[2]
