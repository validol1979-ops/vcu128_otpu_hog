+@pytest.mark.parametrize("fmt", ["int8", "fp4"])
+def test_padded_round_robin(tmp_path, fmt):
+    """Two KV heads per slice in round-robin order; F needs padding to S*q."""
+    _, W, spec = _model(tmp_path, (S_, F_), shared=0, hidden=512, ffn=1030, n_kv=4)
+    cfg = replace(_cfg(), S=2)
+    eng = Engine(spec, W, cap=512, cfg=cfg, wformat=fmt)
+    toks = [5, 300, 777]
+    dev = np.array([eng.step(t) for t in toks])
+    emu = G.emulated_logits(spec, W, toks, S=2, wformat=fmt)
+    assert _cos(G.softcap(spec, dev), G.softcap(spec, emu)).min() > 0.99
+    for sid in range(2):
+        assert list(eng.image.descriptors(sid).layer(0).kv.owned_heads(4)) == [sid, sid + 2]
