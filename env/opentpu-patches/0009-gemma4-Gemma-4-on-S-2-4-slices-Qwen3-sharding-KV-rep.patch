--- /dev/null
+++ b/tests/test_gemma4_slices.py
@@ -0,0 +1,135 @@
+"""Gemma 4's head-parallel attention, replicated KV and sandwich norms across slices."""
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from opentpu.llm import gemma4 as G
+from opentpu.llm.qwen3 import Engine
+from test_gemma4 import _model, _cfg, _cos, S_, F_
+
+
+@pytest.fixture(scope="module", params=[1, 2])
+def tiny_slices(request, tmp_path_factory):
+    return _model(tmp_path_factory.mktemp("gemma4-slices"),
+                  (S_, S_, F_, S_, F_), shared=2, hidden=512, ffn=1024, n_kv=request.param)
+
+
+def _replicas(eng):
+    img = eng.image
+    if img.rep == 1:
+        return
+    for li in range(img.spec.layers):
+        if img.spec.kv_src[li] != li:
+            continue
+        for s in range(img.cfg.S):
+            kv = img.descriptors(s).layer(li).kv
+            peer = img.descriptors(s ^ 1).layer(li).kv
+            h = s // img.rep
+            assert list(kv.owned_heads(img.spec.n_kv)) == [h]
+            for name, size in (("k", kv.cap * kv.ps), ("vt", kv.d * kv.cap),
+                               ("vs", 4 * kv.cap)):
+                a, b = kv.heads[h][name].static(), peer.heads[h][name].static()
+                assert np.array_equal(eng.backend.read(s, a, size),
+                                      eng.backend.read(s ^ 1, b, size)), (li, s, name)
+
+
+@pytest.mark.parametrize("S", [2, 4])
+@pytest.mark.parametrize("fmt", ["int8", "fp4"])
+def test_slices(tiny_slices, S, fmt, monkeypatch):
+    monkeypatch.setenv("OTPU_PLE_FORMAT", fmt)
+    monkeypatch.setenv("OTPU_PLE_HOST", "0")
+    _, W, spec = tiny_slices
+    cfg = replace(_cfg(), S=S)
+    kw = dict(cap=1024, cfg=cfg, wformat=fmt)
+    a, b = Engine(spec, W, resident=True, **kw), Engine(spec, W, **kw)
+    toks = [int(t) for t in np.random.default_rng(6).integers(0, 1000, 12)]
+    dev = np.array([b.step(t) for t in toks])
+    emu = G.emulated_logits(spec, W, toks, S=S, wformat=fmt, ple_format=fmt)
+    assert _cos(G.softcap(spec, dev), G.softcap(spec, emu)).min() > 0.99
+    assert a.resident
+    for t, want in zip(toks[:3], dev[:3]):
+        assert np.array_equal(a.step(t).view(np.uint32), want.view(np.uint32))
+    assert np.array_equal(a.prefill(toks[3:9], chunk=4).view(np.uint32), dev[8].view(np.uint32))
+    for t, want in zip(toks[9:], dev[9:]):
+        assert np.array_equal(a.step(t).view(np.uint32), want.view(np.uint32))
+    _replicas(a)
+    _replicas(b)
+    t0 = int(np.argmax(dev[-1]))
+    t, ref = t0, []
+    for _ in range(4):
+        t = int(np.argmax(b.step(t)))
+        ref.append(t)
+    assert a.can_generate and a.generate_card(t0, 4, stop_ids=[]) == ref
+    _replicas(a)
+
