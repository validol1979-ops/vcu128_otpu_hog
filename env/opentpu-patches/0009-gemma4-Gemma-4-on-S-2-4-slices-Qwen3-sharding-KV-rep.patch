+def test_host_ple_and_prompt_runs(tmp_path, monkeypatch):
+    """The PLE server broadcasts records during generation, and prompt runs gather every slice."""
+    _, W, spec = _model(tmp_path, (S_, F_), shared=0, hidden=512, ffn=1024, n_kv=2)
+    cfg = replace(_cfg(), S=4)
+    kw = dict(cap=512, cfg=cfg, resident=True, wformat="fp4", head_format="int8",
+              prompt_runs=True)
+    monkeypatch.setenv("OTPU_PLE_FORMAT", "int8")
+    monkeypatch.setenv("OTPU_PLE_HOST", "0")
+    a = Engine(spec, W, **kw)
+    monkeypatch.setenv("OTPU_PLE_HOST", "1")
+    b = Engine(spec, W, **kw)
+    toks = [5, 17, 300, 999, 12, 800]
+    dev = np.array([a.step(t) for t in toks])
+    assert b.image.ple_host and b.row_server is not None
+    assert np.array_equal(b.prefill(toks).view(np.uint32), dev[-1].view(np.uint32))
+    assert b._prompt_progs
+    _replicas(b)
+    t0 = int(np.argmax(dev[-1]))
+    t, ref = t0, []
+    for _ in range(4):
+        t = int(np.argmax(a.step(t)))
+        ref.append(t)
+    assert b.generate_card(t0, 4, stop_ids=[]) == ref
+    _replicas(b)
+
+
+def test_layer_run_entry_points(tiny_slices):
+    """The dense layer-major entry points also emit a program for every slice."""
+    spec = replace(tiny_slices[2], ple_dim=0)
+    img = spec.image(replace(_cfg(), S=4), 512, lookup=True, prefill_rows=8)
+    for progs, args in (img.compile_layer_run(-1, 1), img.compile_layer_run(0, 1, R=2),
+                        img.compile_prefill_head()):
+        assert len(progs) == 4 and any(v.name == "row" for v, _ in args)
+
