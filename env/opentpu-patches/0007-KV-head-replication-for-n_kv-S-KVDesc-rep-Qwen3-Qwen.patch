+            if not hasattr(lw, "kv"):
+                continue
+            kv = lw.kv
+            assert kv.rep == 2 and list(kv.owned_heads(spec.n_kv)) == [s // 2]
+            assert list(kv.heads) == [s // 2]
+            peer = img.descriptors(s ^ 1).layer(li).kv
+            for name, size in (("k", kv.cap * kv.d),
+                               ("ks", kv.cap * k_scale_bytes(kv.d, kv.D)),
+                               ("vt", kv.d * kv.cap), ("vs", 4 * kv.cap)):
+                a = Affine.of(kv.heads[s // 2][name]).static()
+                b = Affine.of(peer.heads[s // 2][name]).static()
+                assert np.array_equal(eng.backend.read(s, a, size),
+                                      eng.backend.read(s ^ 1, b, size)), (li, s, name)
+
+
+@pytest.mark.parametrize("S,n_kv", [(4, 2), (2, 1)])
+def test_tiny_replicated_kv_heads(S, n_kv):
+    """Consecutive slices share one KV head and split its queries: emulation accuracy,
+    resident and prefill logits equal per-position decode, and KV replicas stay identical."""
+    _, W, spec = _tiny_model(hidden=S * 128, n_q=2 * S, n_kv=n_kv)
+    cfg = device_config(spec, 256, S=S, MCOLS=2, lookup=True, rows=8)
+    a = Engine(spec, W, cap=256, cfg=cfg, resident=True)
+    b = Engine(spec, W, cap=256, cfg=cfg)
+    toks = [int(t) for t in np.random.default_rng(6).integers(0, 1000, 12)]
+    dev = np.array([b.step(t) for t in toks])
+    assert _cos(dev, emulated_logits(spec, W, toks, S=S)).min() > 0.9995
+    assert a.resident
+    for t, want in zip(toks[:3], dev[:3]):
+        assert np.array_equal(a.step(t).view(np.uint32), want.view(np.uint32))
+    assert np.array_equal(a.prefill(toks[3:9], chunk=4).view(np.uint32), dev[8].view(np.uint32))
+    for t, want in zip(toks[9:], dev[9:]):
+        assert np.array_equal(a.step(t).view(np.uint32), want.view(np.uint32))
+    _assert_kv_replicas(a)
+    _assert_kv_replicas(b)
 
 
