Subject: [PATCH 08/10] fit_embed: int8 embedding table where an fp32 one takes
 over half a slice's DRAM (chat, serve)

qwen35.EMBED_F32_MAX (2 GiB, half a 4 GiB card) kept Qwen3.5-2B's 1.9 GiB fp32 table, and at S > 1
every slice holds it: at S = 4 with 2 GiB a slice the image was 2263 MiB (cap 2048). After the
configuration is known (make_backend), chat and serve take Spec.embed int8 when 4 * vocab * hidden >
cfg.DRAM_BYTES / 2: 823 MiB a slice (cap 2048), 983 MiB (cap 32768). S = 2 (4 GiB a slice) unchanged.
tests/test_fit_embed.py. VCU128 S = 4 (07B2A8C): Qwen3.5-2B 66.3 tok/s, 16 tokens = ISA bit for bit.

diff --git a/opentpu/host/chat.py b/opentpu/host/chat.py
index 23cd71ae..4e60ac96 100644
--- a/opentpu/host/chat.py
+++ b/opentpu/host/chat.py
@@ -1135,6 +1135,8 @@ def main(argv=None):
                                     head_format=a.head_format)
     except ConfigMismatch as e:
         raise SystemExit(f"otpu-chat: {e}") from None
+    from opentpu.llm import fit_embed
+    spec = fit_embed(spec, cfg)     # (an fp32 embedding table over half a slice's DRAM: int8)
     if a.mtp and (not hasattr(spec, "mtp") or a.per_position):
         raise SystemExit("otpu-chat: --mtp takes a Qwen3.5 model and resident decode")
     if cfg is None and not streams and not a.mtp and not _maps_on_design(spec):
diff --git a/opentpu/llm/__init__.py b/opentpu/llm/__init__.py
index c08e9445..01c8fc98 100644
--- a/opentpu/llm/__init__.py
+++ b/opentpu/llm/__init__.py
@@ -56,3 +56,17 @@ def load_spec(path):
         raise ValueError(f"{path}: model type {t!r} is not supported (qwen3, lfm2, qwen3_5 and "
                          f"their MoE variants, gemma4, minicpmv4_7, {', '.join(MODEL_TYPES)})")
     return Spec.from_hf(path)
+
+
+def fit_embed(spec, cfg):
+    """spec with its embedding rows int8 (Spec.embed) where an fp32 table would take over half of a
+    slice's DRAM (cfg.DRAM_BYTES; at S > 1 every slice holds the table): Qwen3.5-2B's fp32 table is
+    1.9 GiB, under qwen35.EMBED_F32_MAX (half a 4 GiB card) but most of a 2 GiB slice (VCU128 at
+    S = 4). A spec without an fp32 table, or no configuration yet (cfg None), is returned as is."""
+    from dataclasses import replace
+    if cfg is None or getattr(spec, "embed", None) != "f32":
+        return spec
+    if 4 * spec.vocab * spec.hidden > cfg.DRAM_BYTES // 2:
+        return replace(spec, embed="int8")
+    return spec
+
