diff --git a/tests/test_fit_embed.py b/tests/test_fit_embed.py
new file mode 100644
index 00000000..4d4488f0
--- /dev/null
+++ b/tests/test_fit_embed.py
@@ -0,0 +1,26 @@
+"""fit_embed: an fp32 embedding table over half a slice's DRAM becomes int8 (Qwen3.5-2B at S = 4)."""
+from dataclasses import dataclass, replace
+
+from opentpu.isasim import Config
+from opentpu.llm import fit_embed
+
+
+@dataclass(frozen=True)
+class _Spec:                    # the fields fit_embed reads (qwen3 / qwen35 / lfm2 Spec have them)
+    hidden: int = 2048          # Qwen3.5-2B
+    vocab: int = 248320
+    embed: str = "f32"
+
+
+def _spec(embed="f32"):
+    return _Spec(embed=embed)
+
+
+def test_fp32_table_over_half_a_slice_goes_int8():
+    s = _spec()                                       # 4 x 248320 x 2048 = 1.9 GiB
+    assert fit_embed(s, Config(S=4, DRAM_BYTES=2 << 30)).embed == "int8"
+    assert fit_embed(s, Config(S=2, DRAM_BYTES=4 << 30)) is s       # under half of 4 GiB: as is
+    assert fit_embed(s, None) is s
+    i8 = _spec("int8")
+    assert fit_embed(i8, Config(S=4, DRAM_BYTES=2 << 30)) is i8
+    assert fit_embed(replace(s, vocab=1000), Config(S=4, DRAM_BYTES=2 << 30)).embed == "f32"
